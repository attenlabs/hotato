# Append to .github/CODEOWNERS. Replace @OWNER with the owner's GitHub login.
# With branch protection "Require review from Code Owners", the agent cannot
# change any gate, scanner, pipeline, infra or job file without the owner.
/autopilot/gates/    @OWNER
/autopilot/scan/     @OWNER
/autopilot/build/    @OWNER
/autopilot/infra/    @OWNER
/autopilot/jobs/     @OWNER
/autopilot/tests/    @OWNER
/.github/            @OWNER
/pricing/            @OWNER
/site/claims/        @OWNER
/pyproject.toml      @OWNER
