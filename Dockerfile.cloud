# hotato cloud: the team web app (optional extra hotato[cloud]) in a container.
#
#   docker build -f Dockerfile.cloud -t hotato-cloud .
#
# Installs from the local source. Runs as a non-root user and listens on 8080.
# The app refuses to start without HOTATO_CLOUD_SECRET. See docs/CLOUD.md.
FROM python:3.12-slim AS builder
WORKDIR /src
COPY pyproject.toml README.pypi.md LICENSE NOTICE MANIFEST.in ./
COPY src ./src
RUN python -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir ".[cloud]"

FROM python:3.12-slim
RUN useradd --create-home --uid 10001 hotato
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1
USER hotato
WORKDIR /home/hotato
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=4).status == 200 else 1)"
CMD ["hotato", "cloud", "serve", "--host", "0.0.0.0", "--port", "8080"]
